<nav id="nav" class="sticky top-0 z-50 w-full bg-[#f7e7ef] /95 backdrop-blur-lg border-b border-primary/10 shadow-sm">
  <div class="container flex items-center justify-between px-5 py-3 mx-auto lg:px-8">

    <!-- LOGO -->
    <a href="/" class="relative flex items-center shrink-0 group">
      <img
        src="/static/img/logo.webp"
        alt="Ayuda Para La Mujer"
        class="object-contain w-auto h-11 transition-transform duration-500 lg:h-14 group-hover:scale-[1.03]"
        width="359"
        height="87"
      />
    </a>

    <!-- MENÚ DESKTOP -->
    {% if navigation.items %}
      <div class="items-center hidden lg:flex">
        <div class="flex items-center gap-1">

          {% for item in navigation.items %}

            {% set isActive = page.url == item.url %}

            <a
              href="{{ item.url }}"
              class="
                group relative flex items-center gap-2
                px-4 py-3
                font-oswald font-semibold text-lg
                rounded-lg
                transition-all duration-300
                {% if isActive %}
                  text-primary
                {% else %}
                  text-stone-700 hover:text-primary
                {% endif %}
              "
            >

              <img
                src="{{ item.icon }}"
                alt=""
                width="23"
                height="23"
                class="
                  transition-all duration-300
                  {% if isActive %}
                    scale-110
                  {% else %}
                    opacity-70 group-hover:opacity-100 group-hover:scale-110
                  {% endif %}
                "
              />

              <span>{{ item.text }}</span>

              <span
                class="
                  absolute bottom-1 left-1/2
                  h-[2px]
                  -translate-x-1/2
                  rounded-full
                  bg-primary
                  transition-all duration-300
                  {% if isActive %}
                    w-8
                  {% else %}
                    w-0 group-hover:w-8
                  {% endif %}
                "
              ></span>

            </a>

          {% endfor %}

        </div>
      </div>
    {% endif %}

    <!-- MENÚ MÓVIL -->
    <div class="dropdown dropdown-end lg:hidden">

      <label
        tabindex="0"
        class="
          flex items-center justify-center
          w-11 h-11
          cursor-pointer
          rounded-full
          text-stone-700
          border border-primary/20
          transition-all duration-300
          hover:bg-primary/10
          hover:text-primary
          hover:border-primary/40
        "
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </label>

      <ul
        tabindex="0"
        class="
          p-3 mt-4
          space-y-1
          w-64
          shadow-2xl
          dropdown-content
          bg-[#f8eef3]
          rounded-2xl
          border border-primary/10
        "
      >

        {% if navigation.items %}

          {% for item in navigation.items %}

            {% set isActive = page.url == item.url %}

            <li>
              <a
                href="{{ item.url }}"
                class="
                  group flex items-center gap-3
                  px-4 py-3
                  rounded-xl
                  font-oswald font-semibold text-lg
                  transition-all duration-300
                  {% if isActive %}
                    bg-primary/10 text-primary
                  {% else %}
                    text-stone-700 hover:bg-primary/5 hover:text-primary
                  {% endif %}
                "
              >

                <img
                  src="{{ item.icon }}"
                  alt=""
                  width="25"
                  height="25"
                  class="transition-transform duration-300 group-hover:scale-110"
                />

                <span>{{ item.text }}</span>

              </a>
            </li>

          {% endfor %}

        {% endif %}

      </ul>

    </div>

  </div>
</nav>